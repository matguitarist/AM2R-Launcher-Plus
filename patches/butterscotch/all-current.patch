+// ===[ Rumble ]===
+// gamepad_set_vibration through Core Haptics: one engine per motor (left and right handle), each playing a
+// looping continuous event whose intensity follows the game. Controllers without handle motors get one
+// engine on the whole controller at the stronger of the two values.
+@interface RumbleMotor : NSObject
+@property (nonatomic, retain) CHHapticEngine *engine;
+@property (nonatomic, retain) id<CHHapticAdvancedPatternPlayer> player;
+@property (nonatomic) float level;
+@property (nonatomic) BOOL playing;
+@end
+@implementation RumbleMotor
+- (void)dealloc {
+    [_player stopAtTime:CHHapticTimeImmediate error:nil];
+    [_engine stopWithCompletionHandler:nil];
+    [_player release];
+    [_engine release];
+    [super dealloc];
+}
+@end
+
+static NSMutableDictionary<NSString *, RumbleMotor *> *rumbleMotors = nil;
+
+static RumbleMotor *rumbleMotor(GCController *controller, GCHapticsLocality locality) API_AVAILABLE(macos(11.0)) {
+    if (rumbleMotors == nil) rumbleMotors = [[NSMutableDictionary alloc] init];
+    NSString *key = [NSString stringWithFormat:@"%p/%@", controller, locality];
+    RumbleMotor *motor = rumbleMotors[key];
+    if (motor != nil) return [motor isKindOfClass:[NSNull class]] ? nil : motor;
+    GCDeviceHaptics *haptics = controller.haptics;
+    CHHapticEngine *engine = [haptics.supportedLocalities containsObject:locality] ? [haptics createEngineWithLocality:locality] : nil;
+    NSError *error = nil;
+    if (engine == nil && [haptics.supportedLocalities containsObject:locality]) {
+        logWarn("Rumble: %s could not create a haptic engine for %s\n", controller.vendorName.UTF8String ?: "controller", locality.UTF8String);
+    }
+    CHHapticEvent *event = [[[CHHapticEvent alloc] initWithEventType:CHHapticEventTypeHapticContinuous
+        parameters:@[[[[CHHapticEventParameter alloc] initWithParameterID:CHHapticEventParameterIDHapticIntensity value:1.0f] autorelease],
+                     [[[CHHapticEventParameter alloc] initWithParameterID:CHHapticEventParameterIDHapticSharpness value:0.2f] autorelease]]
+        relativeTime:0 duration:1.0] autorelease];
+    CHHapticPattern *pattern = engine ? [[[CHHapticPattern alloc] initWithEvents:@[event] parameters:@[] error:&error] autorelease] : nil;
+    id<CHHapticAdvancedPatternPlayer> player = pattern && [engine startAndReturnError:&error] ? [engine createAdvancedPlayerWithPattern:pattern error:&error] : nil;
+    if (player == nil) {
+        if (engine != nil) {
+            logWarn("Rumble: %s %s failed: %s\n", controller.vendorName.UTF8String ?: "controller", locality.UTF8String,
+                    error.localizedDescription.UTF8String ?: "unknown error");
+        }
+        rumbleMotors[key] = (RumbleMotor *)[NSNull null];
+        return nil;
+    }
+    player.loopEnabled = YES;
+    motor = [[[RumbleMotor alloc] init] autorelease];
+    motor.engine = engine;
+    motor.player = player;
+    engine.resetHandler = ^{ motor.playing = NO; [motor.engine startAndReturnError:nil]; };
+    rumbleMotors[key] = motor;
+    return motor;
+}
+
+static void rumbleSet(RumbleMotor *motor, float level) {
+    if (motor == nil || fabsf(level - motor.level) < 0.01f) return;
+    motor.level = level;
+    if (level <= 0.0f) {
+        if (motor.playing) [motor.player stopAtTime:CHHapticTimeImmediate error:nil];
+        motor.playing = NO;
+        return;
+    }
+    CHHapticDynamicParameter *intensity = [[[CHHapticDynamicParameter alloc]
+        initWithParameterID:CHHapticDynamicParameterIDHapticIntensityControl value:level relativeTime:0] autorelease];
+    if (!motor.playing) {
+        motor.playing = [motor.player startAtTime:CHHapticTimeImmediate error:nil];
+    }
+    [motor.player sendParameters:@[intensity] atTime:CHHapticTimeImmediate error:nil];
+}
+
+static void platformSetGamepadVibration(int32_t device, float left, float right) {
+    static bool loggedRequest = false;
+    if (!loggedRequest && (left > 0 || right > 0)) {
+        loggedRequest = true;
+        logInfo("Rumble: the game asked device %d for left %.2f, right %.2f\n", device, left, right);
+    }
+    if (@available(macOS 11.0, *)) {
+        NSArray<GCController *> *controllers = [GCController controllers];
+        if (device < 0 || device >= (int32_t) MIN((NSUInteger) MAX_GAMEPADS, controllers.count)) {
+            static bool loggedDevice = false;
+            if (!loggedDevice) {
+                loggedDevice = true;
+                logWarn("Rumble: device %d is not one of the %lu connected controllers\n", device, (unsigned long) controllers.count);
+            }
+            return;
+        }
+        GCController *controller = controllers[device];
+        static NSMutableSet<NSString *> *reported = nil;
+        if (reported == nil) reported = [[NSMutableSet alloc] init];
+        NSString *name = controller.vendorName ?: @"controller";
+        if (![reported containsObject:name]) {
+            [reported addObject:name];
+            NSArray *localities = [[controller.haptics.supportedLocalities allObjects] sortedArrayUsingSelector:@selector(compare:)];
+            logInfo("Rumble: %s (%s): %s\n", name.UTF8String, controller.productCategory.UTF8String,
+                    controller.haptics == nil ? "no haptics on macOS" : [localities componentsJoinedByString:@", "].UTF8String);
+        }
+        if (controller.haptics == nil) return;
+        RumbleMotor *leftMotor = rumbleMotor(controller, GCHapticsLocalityLeftHandle);
+        RumbleMotor *rightMotor = rumbleMotor(controller, GCHapticsLocalityRightHandle);
+        if (leftMotor != nil || rightMotor != nil) {
+            rumbleSet(leftMotor, left);
+            rumbleSet(rightMotor, right);
+        } else {
+            rumbleSet(rumbleMotor(controller, GCHapticsLocalityDefault), fmaxf(left, right));
+        }
+    }
+}
+
+static void rumbleStopAll(void) {
+    [rumbleMotors release];
+    rumbleMotors = nil;
+}
