+static uint32_t GLCommon_allocTexturePageSlot(GLRenderer* gl) {
+    for (uint32_t i = gl->originalTexturePageCount; gl->textureCount > i; i++) {
+        if (gl->glTextures[i] == 0) return i;
+    }
+    uint32_t pageId = gl->textureCount++;
+    gl->glTextures = (GLuint *)safeRealloc(gl->glTextures, gl->textureCount * sizeof(GLuint));
+    gl->textureWidths = (int32_t *)safeRealloc(gl->textureWidths, gl->textureCount * sizeof(int32_t));
+    gl->textureHeights = (int32_t *)safeRealloc(gl->textureHeights, gl->textureCount * sizeof(int32_t));
+    gl->textureLoaded = (bool *)safeRealloc(gl->textureLoaded, gl->textureCount * sizeof(bool));
+    gl->glTextures[pageId] = 0;
+    gl->textureWidths[pageId] = 0;
+    gl->textureHeights[pageId] = 0;
+    gl->textureLoaded[pageId] = false;
+    return pageId;
+}
+
+static uint32_t GLCommon_allocTpagSlot(DataWin* dw, uint32_t originalTpagCount) {
+    for (uint32_t i = originalTpagCount; dw->tpag.count > i; i++) {
+        if (dw->tpag.items[i].texturePageId == -1) return i;
+    }
+    uint32_t index = dw->tpag.count++;
+    dw->tpag.items = (TexturePageItem *)safeRealloc(dw->tpag.items, dw->tpag.count * sizeof(TexturePageItem));
+    memset(&dw->tpag.items[index], 0, sizeof(TexturePageItem));
+    dw->tpag.items[index].texturePageId = -1;
+    return index;
+}
+
+int32_t GLCommon_createSpriteFromPixels(Renderer* renderer, const uint8_t* rgba, int32_t w, int32_t h, int32_t frames, int32_t xorig, int32_t yorig, int32_t targetSprite) {
+    GLRenderer* gl = (GLRenderer*) renderer;
+    DataWin* dw = renderer->dataWin;
+    if (rgba == nullptr || 0 >= w || 0 >= h) return -1;
+    if (0 >= frames) frames = 1;
+    int32_t frameW = w / frames;
+    if (0 >= frameW) { frames = 1; frameW = w; }
+    if (targetSprite >= 0 && (uint32_t) targetSprite >= dw->sprt.count) return -1;
+
+    // Pending batched draws reference the currently bound texture; flush before binding ours.
+    if (renderer->vtable->flush != nullptr) renderer->vtable->flush(renderer);
+
+    // One GL texture holds the whole strip; each frame is a TPAG into it.
+    GLuint texId;
+    glGenTextures(1, &texId);
+    glBindTexture(GL_TEXTURE_2D, texId);
+    glTexImage2D(GL_TEXTURE_2D, 0, GLCommon_surfaceInternalFormat(gl), w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+    GLCommon_applyTexFilter(renderer->texFilter);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+    uint32_t pageId = GLCommon_allocTexturePageSlot(gl);
+    gl->glTextures[pageId] = texId;
+    gl->textureWidths[pageId] = w;
+    gl->textureHeights[pageId] = h;
+    gl->textureLoaded[pageId] = true;
+
+    int32_t* tpagIndices = (int32_t *)safeMalloc((size_t) frames * sizeof(int32_t));
+    for (int32_t f = 0; frames > f; f++) {
+        uint32_t tpagIndex = GLCommon_allocTpagSlot(dw, gl->originalTpagCount);
+        TexturePageItem* tpag = &dw->tpag.items[tpagIndex];
+        tpag->sourceX = (uint16_t) (f * frameW);
+        tpag->sourceY = 0;
+        tpag->sourceWidth = (uint16_t) frameW;
+        tpag->sourceHeight = (uint16_t) h;
+        tpag->targetX = 0;
+        tpag->targetY = 0;
+        tpag->targetWidth = (uint16_t) frameW;
+        tpag->targetHeight = (uint16_t) h;
+        tpag->boundingWidth = (uint16_t) frameW;
+        tpag->boundingHeight = (uint16_t) h;
+        tpag->texturePageId = (int16_t) pageId;
+        tpagIndices[f] = (int32_t) tpagIndex;
+    }
+
+    uint32_t spriteIndex;
+    Sprite* sprite;
+    if (targetSprite >= 0) {
+        // sprite_replace: keep the name and collision masks, swap in the new frames.
+        // The old TPAGs/texture of a dynamic sprite are left allocated (the frames array of a data.win sprite isn't ours to free).
+        spriteIndex = (uint32_t) targetSprite;
+        sprite = &dw->sprt.sprites[spriteIndex];
+    } else {
+        spriteIndex = DataWin_allocSpriteSlot(dw, gl->originalSpriteCount);
+        sprite = &dw->sprt.sprites[spriteIndex];
+        sprite->maskCount = 0;
+        sprite->masks = nullptr;
+    }
+    sprite->present = true;
+    sprite->width = (uint32_t) frameW;
+    sprite->height = (uint32_t) h;
+    sprite->marginLeft = 0;
+    sprite->marginTop = 0;
+    sprite->marginRight = frameW - 1;
+    sprite->marginBottom = h - 1;
+    sprite->originX = xorig;
+    sprite->originY = yorig;
+    sprite->textureCount = (uint32_t) frames;
+    sprite->tpagIndices = tpagIndices;
+
+    logInfo("GL: %s sprite %u from image (%dx%d, %d frame%s)\n", targetSprite >= 0 ? "Replaced" : "Created", spriteIndex, w, h, frames, frames == 1 ? "" : "s");
+    return (int32_t) spriteIndex;
+}
