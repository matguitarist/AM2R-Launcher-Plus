+// Decodes an image file (png/jpg/gif/bmp) from the game's file system to RGBA. Caller frees with stbi_image_free.
+static uint8_t* loadImageFileRGBA(VMContext* ctx, const char* path, bool removeback, int32_t* outW, int32_t* outH) {
+    FileSystem* fs = ctx->runner->fileSystem;
+    if (fs == nullptr || path == nullptr) return nullptr;
+    uint8_t* data = nullptr;
+    int32_t size = 0;
+    if (!fs->vtable->readFileBinary(fs, path, &data, &size) || data == nullptr) {
+        logWarn("[sprite_add] Could not read image \"%s\"\n", path);
+        return nullptr;
+    }
+    int w = 0, h = 0, channels = 0;
+    uint8_t* pixels = stbi_load_from_memory(data, size, &w, &h, &channels, 4);
+    free(data);
+    if (pixels == nullptr) {
+        logWarn("[sprite_add] Could not decode image \"%s\"\n", path);
+        return nullptr;
+    }
+    if (removeback) {
+        // GameMaker: the bottom-left pixel's colour becomes transparent.
+        uint32_t back;
+        memcpy(&back, pixels + (size_t) (h - 1) * (size_t) w * 4, 4);
+        for (size_t i = 0; (size_t) w * (size_t) h > i; i++) {
+            uint32_t px;
+            memcpy(&px, pixels + i * 4, 4);
+            if (px == back) pixels[i * 4 + 3] = 0;
+        }
+    }
+    *outW = w;
+    *outH = h;
+    return pixels;
+}
+
+static int32_t createSpriteFromImageFile(VMContext* ctx, const char* path, int32_t frames, bool removeback, int32_t xorig, int32_t yorig, int32_t targetSprite) {
+    Renderer* renderer = ctx->runner->renderer;
+    if (renderer == nullptr || renderer->vtable->createSpriteFromPixels == nullptr) return -1;
+    int32_t w = 0, h = 0;
+    uint8_t* pixels = loadImageFileRGBA(ctx, path, removeback, &w, &h);
+    if (pixels == nullptr) return -1;
+    int32_t result = renderer->vtable->createSpriteFromPixels(renderer, pixels, w, h, frames, xorig, yorig, targetSprite);
+    stbi_image_free(pixels);
+    return result;
+}
+
+// sprite_add(fname, imgnumb, removeback, smooth, xorig, yorig)
+static RValue builtin_sprite_add(VMContext* ctx, RValue* args, int32_t argCount) {
+    REQUIRE_ARGC_AT_LEAST("sprite_add", 6, RValue_makeReal(-1.0));
+    char* path = RValue_toString(args[0], ctx->dataWin);
+    int32_t result = createSpriteFromImageFile(ctx, path, RValue_toInt32(args[1]), RValue_toBool(args[2]), RValue_toInt32(args[4]), RValue_toInt32(args[5]), -1);
+    free(path);
+    return RValue_makeReal((GMLReal) result);
+}
+
+// sprite_replace(ind, fname, imgnumb, removeback, smooth, xorig, yorig)
+static RValue builtin_sprite_replace(VMContext* ctx, RValue* args, int32_t argCount) {
+    REQUIRE_ARGC_AT_LEAST("sprite_replace", 7, RValue_makeUndefined());
