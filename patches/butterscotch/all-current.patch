+    if (0 > spriteIndex || (uint32_t) spriteIndex >= ctx->dataWin->sprt.count) return RValue_makeUndefined();
+    char* path = RValue_toString(args[1], ctx->dataWin);
+    createSpriteFromImageFile(ctx, path, RValue_toInt32(args[2]), RValue_toBool(args[3]), RValue_toInt32(args[5]), RValue_toInt32(args[6]), spriteIndex);
