     free(runner);
 }
+
+// GameMaker 1.4 handles display_reset() by recreating the graphics device once the frame is done, losing every surface
+// except the application surface. Games rely on it to rebuild surfaces at a new size: AM2R 1.5.5 creates its widescreen
+// view surface on the first frame (before its width is known) and only recreates it when surface_exists() turns false.
+void Runner_applyPendingDisplayReset(Runner* runner) {
+    if (!runner->pendingDisplayReset) return;
+    runner->pendingDisplayReset = false;
+    Renderer* renderer = runner->renderer;
+    if (renderer == nullptr || renderer->vtable->surfaceExists == nullptr || renderer->vtable->surfaceFree == nullptr) return;
+    for (int32_t id = 0; 4096 > id; id++) {
+        if (id == runner->applicationSurfaceId) continue;
+        if (renderer->vtable->surfaceExists(renderer, id)) renderer->vtable->surfaceFree(renderer, id);
+    }
+    logInfo("Runner: display_reset applied, surfaces lost\n");
+}
