+// [x1, y1, x2, y2] of the application surface in the window. When the game draws the application
+// surface itself, the GUI layer covers the window from its origin (see loop.c), so that is the answer.
+static RValue builtin_application_get_position(VMContext* ctx, MAYBE_UNUSED RValue* args, MAYBE_UNUSED int32_t argCount) {
+    Runner* runner = ctx->runner;
+    GMLArray* out = GMLArray_create(ctx->dataWin, 4);
+    int32_t x = 0, y = 0, w = 0, h = 0;
+    if (runner != nullptr) {
+        int32_t windowW = runner->viewportX * 2 + runner->viewportW, windowH = runner->viewportY * 2 + runner->viewportH;
+        if (runner->appSurfaceAutoDraw) {
+            x = runner->viewportX; y = runner->viewportY; w = runner->viewportW; h = runner->viewportH;
+        } else {
+            w = windowW; h = windowH;
+        }
+    }
+    *GMLArray_slot(out, 0) = RValue_makeReal(x);
+    *GMLArray_slot(out, 1) = RValue_makeReal(y);
+    *GMLArray_slot(out, 2) = RValue_makeReal(x + w);
+    *GMLArray_slot(out, 3) = RValue_makeReal(y + h);
+    return RValue_makeArray(out);
+}
 
