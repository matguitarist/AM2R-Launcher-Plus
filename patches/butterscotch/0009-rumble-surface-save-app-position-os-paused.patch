+typedef struct { uint8_t* data; int32_t size; } PngBuffer;
+
+static void appendPng(void* context, void* data, int size) {
+    PngBuffer* buffer = (PngBuffer*) context;
+    uint8_t* grown = (uint8_t*) realloc(buffer->data, (size_t) buffer->size + (size_t) size);
+    if (grown == nullptr) return;
+    memcpy(grown + buffer->size, data, (size_t) size);
+    buffer->data = grown;
+    buffer->size += size;
+}
+
+// surface_save(surface, fname): a PNG whatever the name, like GMS. AM2R saves its pause backdrop
+// as working_directory + "/tempscr" and reloads it with background_add when the surface was lost.
+static RValue builtin_surface_save(VMContext* ctx, RValue* args, int32_t argCount) {
+    Runner* runner = ctx->runner;
+    if (runner == nullptr || runner->fileSystem == nullptr || argCount < 2) return RValue_makeBool(false);
+    int32_t surfaceId = (int32_t) RValue_toReal(args[0]);
+    int32_t w = (int32_t) Renderer_getSurfaceWidth(runner->renderer, surfaceId);
+    int32_t h = (int32_t) Renderer_getSurfaceHeight(runner->renderer, surfaceId);
+    if (w <= 0 || h <= 0) return RValue_makeBool(false);
+    uint8_t* pixels = (uint8_t*) safeMalloc((size_t) w * (size_t) h * 4);
+    if (!runner->renderer->vtable->surfaceGetPixels(runner->renderer, surfaceId, pixels)) {
+        free(pixels);
+        return RValue_makeBool(false);
+    }
+    // surfaceGetPixels returns the bottom row first; a negative stride writes it top down.
+    PngBuffer png = { nullptr, 0 };
+    int stride = w * 4;
+    bool ok = stbi_write_png_to_func(appendPng, &png, w, h, 4, pixels + (size_t) (h - 1) * (size_t) stride, -stride) != 0;
+    free(pixels);
+    char* path = RValue_toString(args[1], ctx->dataWin);
+    ok = ok && png.data != nullptr && runner->fileSystem->vtable->writeFileBinary(runner->fileSystem, path, png.data, png.size);
+    free(path);
+    free(png.data);
+    return RValue_makeBool(ok);
 }
 
