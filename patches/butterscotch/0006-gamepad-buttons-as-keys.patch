 #define USE_PRIVATE_API 0
 
+// Controller buttons that also act as keyboard keys, for games with no gamepad binding for an action
+// (AM2R opens its pause menu only from Escape). BUTTERSCOTCH_GAMEPAD_KEYS="32778=27,..." maps a
+// gp_* constant to a GML key code, for every controller.
+#define MAX_GAMEPAD_KEYS 8
+static int gamepadKeyCount = -1;
+static int gamepadKeyButton[MAX_GAMEPAD_KEYS];
+static int gamepadKeyCode[MAX_GAMEPAD_KEYS];
+static bool gamepadKeyDown[MAX_GAMEPAD_KEYS];
+
+static void appkitLoadGamepadKeys(void) {
+    gamepadKeyCount = 0;
+    const char *spec = getenv("BUTTERSCOTCH_GAMEPAD_KEYS");
+    while (spec && *spec && gamepadKeyCount < MAX_GAMEPAD_KEYS) {
+        int button = 0, key = 0, used = 0;
+        if (sscanf(spec, "%d=%d%n", &button, &key, &used) != 2) break;
+        int index = button >= 32769 ? button - 32769 : button;
+        if (index >= 0 && index < GP_BUTTON_COUNT && key > 0 && key < 256) {
+            gamepadKeyButton[gamepadKeyCount] = index;
+            gamepadKeyCode[gamepadKeyCount] = key;
+            gamepadKeyDown[gamepadKeyCount] = false;
+            gamepadKeyCount++;
+        }
+        spec += used;
+        if (*spec == ',') spec++;
+    }
+}
+
+static void appkitUpdateGamepadKeys(void) {
+    if (gamepadKeyCount < 0) appkitLoadGamepadKeys();
+    for (int i = 0; i < gamepadKeyCount; i++) {
+        bool down = false;
+        for (int slotIdx = 0; slotIdx < MAX_GAMEPADS; slotIdx++) {
+            GamepadSlot *slot = g_runner->gamepads->slots + slotIdx;
+            if (slot->connected && slot->buttonDown[gamepadKeyButton[i]]) down = true;
+        }
+        if (down && !gamepadKeyDown[i]) RunnerKeyboard_onKeyDown(g_runner->keyboard, gamepadKeyCode[i]);
+        if (!down && gamepadKeyDown[i]) RunnerKeyboard_onKeyUp(g_runner->keyboard, gamepadKeyCode[i]);
+        gamepadKeyDown[i] = down;
+    }
+}
