+// display_get_width/height in pixels, in the same units as window_get_width/height.
+// In fullscreen, report the drawable area (on notched displays it is smaller than the panel),
+// so games that center on the display size fill the window exactly.
+static bool platformGetDisplaySize(int32_t *outW, int32_t *outH) {
+    if (window == nil) return false;
+    if (platformGetWindowFullscreen() && glView != nil) {
+        NSRect backing = [glView convertRectToBacking:[glView bounds]];
+        *outW = (int32_t) backing.size.width;
+        *outH = (int32_t) backing.size.height;
+        return true;
+    }
+    NSScreen *screen = [window screen] ?: [NSScreen mainScreen];
+    if (screen == nil) return false;
+    CGFloat scale = [screen backingScaleFactor];
+    *outW = (int32_t) (screen.frame.size.width * scale);
+    *outH = (int32_t) (screen.frame.size.height * scale);
+    return true;
+}
+
 static void platformSetWindowFullscreen(bool fullscreen) {
     if (fullscreen == platformGetWindowFullscreen()) return;
     [window toggleFullScreen:nil];
