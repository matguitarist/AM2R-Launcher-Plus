+// file_text_open_append(fname): like open_write, but starts from the file's current text so writes go at the end.
+static RValue builtin_file_text_open_append(VMContext* ctx, RValue* args, int32_t argCount) {
+    RValue handle = builtin_file_text_open_write(ctx, args, argCount);
+    int32_t slot = RValue_toInt32(handle);
+    if (0 > slot) return handle;
+    Runner* runner = ctx->runner;
+    FileSystem* fs = runner->fileSystem;
+    char* existing = fs->vtable->readFileText(fs, runner->openTextFiles[slot].filePath);
+    if (existing != nullptr) {
+        free(runner->openTextFiles[slot].writeBuffer);
+        runner->openTextFiles[slot].writeBuffer = existing;
+    }
+    return handle;
 }
 
