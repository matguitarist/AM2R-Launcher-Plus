+// background_replace(ind, fname, removeback, smooth): points an existing background at a new image.
+// AM2R swaps its title logo for the one in lang/titles/ that matches the game language.
+static RValue builtin_background_replace(VMContext* ctx, RValue* args, int32_t argCount) {
+    REQUIRE_ARGC_AT_LEAST("background_replace", 2, RValue_makeUndefined());
+    DataWin* dw = ctx->dataWin;
+    int32_t bgIndex = RValue_toInt32(args[0]);
+    if (0 > bgIndex || (uint32_t) bgIndex >= dw->bgnd.count) return RValue_makeUndefined();
+    char* path = RValue_toString(args[1], dw);
+    bool removeback = argCount > 2 && RValue_toBool(args[2]);
+    int32_t spriteIndex = createSpriteFromImageFile(ctx, path, 1, removeback, 0, 0, -1);
+    free(path);
+    if (0 > spriteIndex) return RValue_makeUndefined();
+    // createSpriteFromImageFile may grow the sprite and TPAG tables; the background table is untouched.
+    dw->bgnd.backgrounds[bgIndex].tpagIndex = dw->sprt.sprites[spriteIndex].tpagIndices[0];
+    return RValue_makeUndefined();
 }
 
