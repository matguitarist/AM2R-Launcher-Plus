+++ b/src/random.c
@@ -3,7 +3,11 @@
 #include "utils.h"
 #include "random.h"
 
+// Seeding restarts the sequence: the same seed always gives the same numbers, like GameMaker.
+// (Before, the read position carried over, so random_set_seed(s) twice gave two different runs.)
 void Random_setSeed(Random* m, uint32_t seed) {
+    m->seed = seed;
+    m->index = 0;
     m->state[0] = seed;
     for (int i = 1; 16 > i; ++i)
         m->state[i] = i + 0x6C078965 * (m->state[i - 1] ^ (m->state[i - 1] >> 30));
--- a/src/random.h
+++ b/src/random.h
@@ -6,6 +6,7 @@
 typedef struct {
     uint32_t state[16];
     uint32_t index;
+    uint32_t seed; // last seed given to Random_setSeed (random_get_seed)
 } Random;
 
 void Random_setSeed(Random* m, uint32_t seed);
