+// joystick_zpos/rpos: the right stick (axes 3 and 4, what joystick_axes counts). upos/vpos: the
+// triggers as 0..1 (axes 5 and 6). AM2R's joypad options let the player pick any of the six.
+static GMLReal joystickExtraAxis(VMContext* ctx, RValue* args, int32_t argCount, int32_t axis, int32_t button) {
+    if (1 > argCount) return 0.0;
+    Runner* runner = ctx->runner;
+    if (runner == NULL || runner->gamepads == NULL) return 0.0;
+    int32_t id = RValue_toInt32(args[0]) - 1;
+    if (axis != 0) return (GMLReal) RunnerGamepad_axisValue(runner->gamepads, id, axis);
+    return (GMLReal) RunnerGamepad_buttonValue(runner->gamepads, id, button);
+}
